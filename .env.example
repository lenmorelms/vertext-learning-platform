# Clerk. Copy to .env.local and fill in, or run `clerk env pull`.
# The publishable key is safe for the browser. The secret key is server only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity. The project id and dataset name are safe for the browser.
# The studio workspace reads the same two values from studio/.env.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional. Defaults to the date in sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=
# Server only. A Viewer token for the private dataset. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Search. All server only. Never prefix with NEXT_PUBLIC_.
# The MCP URL ends with the Context document slug (vertex-search). The MCP is
# called with SANITY_API_READ_TOKEN.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>/vertex-search

OPENAI_API_KEY=

# Optional. Defaults to the model in lib/search/agent.ts.
OPENAI_MODEL=gpt-5.4-mini
