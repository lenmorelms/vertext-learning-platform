# Sanity Studio. Copy to .env and fill in.
# Use the same project and dataset as the web app's NEXT_PUBLIC_SANITY_* values.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
# Hostname for `sanity deploy`, served at <hostname>.sanity.studio. Must be globally unique.
# The Sanity Context MCP only serves a dataset with a deployed Studio.
SANITY_STUDIO_HOSTNAME=
